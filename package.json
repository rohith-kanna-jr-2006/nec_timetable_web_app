{
  "name": "nec-faculty-timetable-system",
  "version": "1.0.0",
  "private": true,
  "description": "Nandha Engineering College (Autonomous) - Faculty Timetable & Workload Management System",
  "workspaces": [
    "backend",
    "web"
  ],
  "scripts": {
    "build:frontend": "npm run build --workspace=web",
    "build": "npm run build:frontend",
    "dev": "node server.js",
    "start": "node server.js",
    "lint": "node -c server.js && node -c backend/src/server.js && node -c backend/src/app.js",
    "test:timetable": "npm run test:timetable --workspace=backend",
    "test": "npm test --workspace=backend && npm test --workspace=web"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5"
  }
}
